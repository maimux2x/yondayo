<div class="auth-brand">
  <%= image_tag "logo/mark.svg", height: 36, alt: "" %>
  <span class="app-wordmark">よんだよ</span>
</div>

<div class="card">
  <div class="card-body p-4">
    <h1 class="h5 mb-3">パスワードを再設定する</h1>

    <%= bootstrap_form_with url: passwords_path do |f| %>
      <%= f.email_field :email_address, label: "メールアドレス", required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
      <%= f.primary "再設定の案内を送る", class: "btn btn-primary w-100" %>
    <% end %>
  </div>
</div>
