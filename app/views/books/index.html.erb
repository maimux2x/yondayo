<nav class="page-nav">
  <%= link_to "← 読書記録", root_path, class: "page-nav-back" %>
</nav>

<h1 class="h4 mb-3">本を検索</h1>

<%= bootstrap_form_with url: books_path, method: :get, class: "mb-4" do |f| %>
  <%= f.search_field :q, label: "タイトル・著者・ISBN", value: params[:q], append: f.primary("検索") %>
<% end %>

<% if @volumes %>
  <% if @volumes.any? %>
    <div class="text-body-secondary small mb-2">検索結果 <%= @volumes.size %> 件</div>

    <div class="d-flex flex-column gap-3">
      <% @volumes.each do |volume| %>
        <div class="card">
          <div class="card-body">
            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
              <h2 class="reading-title mb-0"><%= volume[:title] %></h2>

              <% if volume[:is_ebook] %>
                <span class="status-tag status-tag--unread flex-shrink-0">電子書籍</span>
              <% end %>
            </div>

            <dl class="meta-list mb-3">
              <% {"著者" => volume[:author], "出版社" => volume[:publisher], "出版日" => volume[:published_date]}.compact_blank.each do |label, value| %>
                <dt><%= label %></dt>
                <dd><%= value %></dd>
              <% end %>
            </dl>

            <%= link_to "この本を記録する →", books_path(volume_id: volume[:id]),
                  data: {turbo_method: :post},
                  class: "btn btn-outline-primary btn-sm w-100" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-body-secondary">検索結果が見つかりません。</p>
  <% end %>
<% end %>
