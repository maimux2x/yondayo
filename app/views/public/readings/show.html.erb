<% content_for :head do %>
  <meta
    property="og:url"
    content="<%= public_reading_url(@reading.share_token) %>"
  >

  <meta property="og:title" content="<%= @reading.user.name %>の読書記録">

  <meta
    property="og:description"
    content="<%= @reading.book.title %> (<%= @reading.book.author %>)"
  >

  <meta property="og:image" content="<%= asset_url("logo.png") %>">
  <meta property="og:site_name" content="よんだよ">
<% end %>

<div class="public-header rounded-3 mb-4">
  <div class="d-flex align-items-center gap-2 mb-3">
    <%= image_tag "logo/mark.svg", height: 20, alt: "", class: "public-mark" %>
    <span class="public-brand">よんだよ</span>
  </div>

  <div class="d-flex align-items-center gap-3">
    <%= avatar_tag @reading.user, class_name: "public-avatar" %>

    <div>
      <div class="public-user"><%= @reading.user.name %>の読書記録</div>

      <time class="public-date" datetime="<%= @reading.created_at.to_date.iso8601 %>">
        <%= l @reading.created_at.to_date, format: :long %>
      </time>
    </div>
  </div>
</div>

<h1 class="h3 mb-2"><%= @reading.book.title %></h1>
<p class="text-body-secondary mb-2"><%= @reading.book.author %></p>

<%= status_tag @reading %>

<hr class="my-4">

<% if @reading.comment.present? %>
  <section class="mb-4">
    <h2 class="field-label fw-normal mb-2">感想</h2>
    <div class="prose"><%= @reading.comment %></div>
  </section>
<% end %>

<footer class="d-flex align-items-center justify-content-between border-top pt-3">
  <span class="text-body-secondary small">読書の記録をつけるサービス</span>
  <%= link_to "よんだよ →", root_path, class: "text-decoration-none" %>
</footer>
