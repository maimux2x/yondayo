<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "よんだよ" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="よんだよ">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%# = tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= preload_link_tag "ShipporiMinchoB1-SemiBold.woff2" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# ログイン前の画面（ログイン・パスワード再設定・共有ページ）は各画面にロゴがあるためヘッダーを出さない %>
    <% if authenticated? %>
      <header class="app-header">
        <div class="container app-container d-flex align-items-center justify-content-between py-2">
          <%= link_to root_path, class: "d-flex align-items-center gap-2 text-decoration-none" do %>
            <%= image_tag "logo/mark.svg", height: 23, alt: "" %>
            <span class="app-wordmark">よんだよ</span>
          <% end %>

          <div class="dropdown">
            <button
              class="btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <%= avatar_tag Current.user, class_name: "app-avatar" %>
              <span class="text-body-secondary small"><%= Current.user.name %></span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <%= link_to "プロフィール編集", edit_profile_path, class: "dropdown-item" %>
              </li>

              <li>
                <%= button_to "ログアウト", session_path, method: :delete, class: "dropdown-item" %>
              </li>
            </ul>
          </div>
        </div>
      </header>
    <% end %>

    <main class="container app-container py-3">
      <% flash.each do |type, message| %>
        <div
          class="alert <%= type == "alert" ? "alert-danger" : "alert-success" %> alert-dismissible fade show"
          role="alert"
        >
          <%= message %>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="閉じる"
          ></button>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
